# ==============================================================================
# SCUM SERVER MANAGER — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME="SCUM Server Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. LOGGING & DIAGNOSTICS
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 3. DATABASE (SQLite Enterprise WAL Mode)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal
PANEL_DB_BUSY_TIMEOUT=5

# ------------------------------------------------------------------------------
# 4. SESSIONS & COOKIES
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=scum_panel_session
SESSION_SECURE_COOKIE=false

# ------------------------------------------------------------------------------
# 5. SECURITY & BRUTE-FORCE PROTECTION
# ------------------------------------------------------------------------------
PANEL_AUTH_MAX_ATTEMPTS=5
PANEL_AUTH_LOCKOUT_SECONDS=7200

# ------------------------------------------------------------------------------
# 6. CACHE, QUEUE & STORAGE
# ------------------------------------------------------------------------------
CACHE_STORE=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 7. SCUM MANAGER: RCON SETTINGS
# ------------------------------------------------------------------------------
PANEL_RCON_CONNECT_TIMEOUT=5
PANEL_RCON_AUTH_TIMEOUT=3
PANEL_RCON_COMMAND_TIMEOUT=15
PANEL_RCON_DEBOUNCE_MS=100
PANEL_RCON_RECONNECT_DELAY=5
PANEL_RCON_STATE_TTL=300
PANEL_RCON_POLL_MS=150

# ------------------------------------------------------------------------------
# 8. SCUM MANAGER: FTP / SFTP & SCUM.db WATCHER
# ------------------------------------------------------------------------------
PANEL_FTP_CONNECT_TIMEOUT=15
PANEL_FTP_POLL_MS=250
PANEL_FTP_STATE_TTL=300
PANEL_FTP_PENDING_TTL=3600
PANEL_SCUMDB_SYNC_SEC=600
PANEL_SCUMDB_TTL=300
PANEL_SFTP_TIMEOUT=15

# ------------------------------------------------------------------------------
# 9. SCUM MANAGER: HTTP CLIENT TIMEOUTS (sec)
# ------------------------------------------------------------------------------
PANEL_HTTP_TIMEOUT=10
PANEL_HTTP_AUTOMATION_TIMEOUT=10
PANEL_HTTP_AUTOMATION_POOL_TIMEOUT=15
PANEL_HTTP_WARGM_TIMEOUT=30
PANEL_HTTP_STEAM_TIMEOUT=6
PANEL_HTTP_LOLKA_TIMEOUT=10
PANEL_WORKFLOW_TIMEOUT=30

# ------------------------------------------------------------------------------
# 10. SCUM MANAGER: CACHE TTLs (sec)
# ------------------------------------------------------------------------------
PANEL_CACHE_SETTINGS_TTL=300
PANEL_CACHE_WORKFLOWS_TTL=5
PANEL_CACHE_FAME_TTL=30
PANEL_CACHE_PROBE_TTL=15
PANEL_CACHE_ONLINE_TTL=10
PANEL_CACHE_CHEST_TTL=3600
PANEL_CACHE_CHEST_GRACE_SEC=60
PANEL_CACHE_LISTING_TTL=30
PANEL_CACHE_STEAM_OK_TTL=86400
PANEL_CACHE_STEAM_FAIL_TTL=3600

# ------------------------------------------------------------------------------
# 11. SCUM MANAGER: DAEMONS, MAP & RATE LIMITS
# ------------------------------------------------------------------------------
PANEL_DAEMON_HEARTBEAT_TTL=30
PANEL_MAP_STATS_POLL_MS=30000
PANEL_RL_LOGIN=5
PANEL_RL_PANEL=120
PANEL_RL_JOBS=600
PANEL_PLUGINS_AUTO_DROP_INTERVAL=30
PANEL_PLUGINS_TOP_INTERVAL_DAYS=1

# ------------------------------------------------------------------------------
# 12. OPTIONAL SERVICES (Redis, Memcached, Mail, AWS)
# ------------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 13. FRONTEND / VITE
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
